{
  "version": "1.0.0",
  "status": "defined-not-enforced",
  "description": "Durability level of every writing tool/action of the TeamHarness MCP. Data only. Every current write is level 'sync': an immediate atomic replace inside the call (_write_json -> _atomic_write_text: same-dir tempfile + fsync + os.replace). No async/background writer and no exit-time flush exist, so 'async' and 'exit' have no current instances.",
  "levels": [
    "sync",
    "async",
    "exit"
  ],
  "level_meaning": {
    "sync": "written synchronously inside the call, before the response is returned",
    "async": "handed to a background writer (none today)",
    "exit": "flushed on process exit (none today)"
  },
  "write_actions": [
    {
      "tool": "projectflow",
      "action": "create_project",
      "level": "sync"
    },
    {
      "tool": "projectflow",
      "action": "create_quick_project",
      "level": "sync"
    },
    {
