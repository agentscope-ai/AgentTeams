# Repo convention: no tracked lockfiles (0 tracked in AgentTeams). The local
# lock pulls the `openclaw` peer into node_modules during development and is
# not part of the plugin artifact.
package-lock.json

# Local dev dependencies (openclaw peer) — never part of the plugin artifact.
node_modules/

# Build output — regenerated by `npm run build` (tsc) before install/verify.
dist/
