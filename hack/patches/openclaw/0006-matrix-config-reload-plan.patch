+        kind: "none",
       }),
     ),
-    ...(plugin.reload?.noopPrefixes ?? []).map(
+    ...(plugin.reload?.configPrefixes ?? []).map(
       (prefix): ReloadRule => ({
         prefix,
-        kind: "none",
+        kind: "hot",
+        actions: [`restart-channel:${plugin.id}` as ReloadAction],
       }),
     ),
