# ============================================================
# AgentTeams Manager Agent - QwenPaw 2.2 Runtime
# ============================================================
# Lightweight Manager container with Python QwenPaw 2.2 runtime.
# Does NOT include Higress, Tuwunel, MinIO, or Element Web.
# All infrastructure is provided by the controller (embedded)
# or K8s Pods (incluster). AGENTTEAMS_RUNTIME env var selects mode.
#
# Build from project root:
#   docker build -f manager/Dockerfile.qwenpaw -t agentteams/manager-qwenpaw:latest .
#
# Build args:
#   HIGRESS_REGISTRY        - base image registry (default: cn-hangzhou)
#   AGENTTEAMS_CONTROLLER_IMAGE - pre-built controller image for agt CLI
#   QWENPAW_PIP_SPEC        - QwenPaw pip spec (default: qwenpaw==2.2.1)
#   PIP_INDEX_URL           - PyPI mirror (default: official pypi.org)
#   APT_MIRROR              - Debian APT mirror (default: empty; set to mirrors.aliyun.com for China)
# ============================================================

ARG HIGRESS_REGISTRY=higress-registry.cn-hangzhou.cr.aliyuncs.com
ARG AGENTTEAMS_CONTROLLER_IMAGE=agentteams/agentteams-controller:latest

# ============ Stage 1: MinIO Client (mc) ============
FROM ${HIGRESS_REGISTRY}/higress/mc:20260216 AS mc

# ============ Stage 2: AgentTeams CLI (from controller image) ============
FROM ${AGENTTEAMS_CONTROLLER_IMAGE} AS agentteams-controller

# ============ Final Image: Python 3.11 ============
FROM ${HIGRESS_REGISTRY}/higress/python:3.11-slim

ARG APT_MIRROR=
ARG PIP_INDEX_URL=https://pypi.org/simple/
ARG NPM_REGISTRY=https://registry.npmjs.org/

# ---- System dependencies ----
RUN if [ -n "${APT_MIRROR}" ]; then \
        sed -i "s|deb.debian.org|${APT_MIRROR}|g" \
            /etc/apt/sources.list.d/debian.sources 2>/dev/null || true; \
    fi && \
    apt-get update && apt-get install -y --no-install-recommends \
        libolm-dev \
        libjemalloc2 \
        git curl jq tzdata ca-certificates openssh-client gettext-base procps \
    && rm -rf /var/lib/apt/lists/*

# Install the latest Node.js 24 LTS (floor: 24.22.1 for the 2026-10-21 security release).
# By default the build resolves the latest 24.x LTS from nodejs.org and verifies its SHA-256.
# For a byte-reproducible build, pass --build-arg NODE_VERSION=24.22.1 (or any 24.x >= floor).
# NODE_MAJOR is fixed to 24: a 25.x/26.x override is rejected even if NODE_MAJOR=24 is passed.
# Docker may reuse this layer: use --no-cache for a forced refresh to the latest 24 LTS.
ARG NODE_MAJOR=24
ARG NODE_MIN_VERSION=24.22.1
ARG NODE_VERSION=
ARG NODE_SHA256=
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl xz-utils jq; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) node_arch="x64" ;; \
      arm64) node_arch="arm64" ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    required_major="24"; \
    if [ "${NODE_MAJOR}" != "${required_major}" ]; then \
      echo "NODE_MAJOR=${NODE_MAJOR} is not Node ${required_major} LTS; refusing to build" >&2; exit 1; \
    fi; \
    case "${NODE_MIN_VERSION}" in 24.*) ;; *) echo "NODE_MIN_VERSION=${NODE_MIN_VERSION} is not Node 24.x" >&2; exit 1 ;; esac; \
    ver="${NODE_VERSION}"; \
    if [ -z "$ver" ]; then \
      ver="$(curl -fsSL https://nodejs.org/dist/index.json | jq -r --arg p "v${NODE_MAJOR}." '[.[] | select(.lts != false) | select(.version | startswith($p))][0].version' | sed 's/^v//')"; \
    fi; \
    ver="${ver#v}"; \
    test -n "$ver"; \
    case "$ver" in \
      *[!0-9.]*|*..*|.*|*.) echo "invalid Node version: $ver" >&2; exit 1 ;; \
    esac; \
    case "$ver" in \
      *.*.*) ;; \
      *) echo "invalid Node version: $ver" >&2; exit 1 ;; \
    esac; \
    case "$ver" in \
      *.*.*.*) echo "invalid Node version: $ver" >&2; exit 1 ;; \
    esac; \
    major="${ver%%.*}"; \
    if [ "$major" != "$required_major" ]; then \
      echo "Node $ver is not a Node ${required_major}.x release; refusing a non-${required_major} major" >&2; exit 1; \
    fi; \
    if [ "$(printf '%s\n%s\n' "$NODE_MIN_VERSION" "$ver" | sort -V | head -n1)" != "$NODE_MIN_VERSION" ]; then \
      echo "Node $ver is older than required floor $NODE_MIN_VERSION" >&2; exit 1; \
    fi; \
    tarball="node-v${ver}-linux-${node_arch}.tar.xz"; \
    sha="${NODE_SHA256}"; \
    if [ -z "$sha" ]; then \
      sha="$(curl -fsSL "https://nodejs.org/dist/v${ver}/SHASUMS256.txt" | awk -v f="$tarball" '$2 == f {print $1}' | head -n1)"; \
    fi; \
    test -n "$sha" || { echo "no SHASUMS256.txt entry for ${tarball}" >&2; exit 1; }; \
    curl -fsSLO "https://nodejs.org/dist/v${ver}/${tarball}"; \
    echo "${sha}  ${tarball}" | sha256sum -c -; \
    tar -xJf "$tarball" -C /usr/local --strip-components=1 --no-same-owner; \
    rm -f "$tarball"; \
    node -v; npm -v; \
    test "$(node -v)" = "v${ver}"; \
    rm -rf /var/lib/apt/lists/*

# jemalloc for memory efficiency
RUN JEMALLOC=$(find /usr/lib -name 'libjemalloc.so.2' -print -quit) \
    && echo "LD_PRELOAD=${JEMALLOC}" >> /etc/environment \
    && echo "${JEMALLOC}" > /etc/ld.so.preload

# ---- Stable binaries from build stages ----
COPY --from=mc /usr/bin/mc /usr/local/bin/mc

# AgentTeams CLI — for worker/team/human management via controller REST API
COPY --from=agentteams-controller /usr/local/bin/agt /usr/local/bin/agt

RUN npm config set registry ${NPM_REGISTRY} && \
    npm install -g mcporter skills @nacos-group/cli && \
    rm -rf /root/.npm

# ---- Python virtual environment (single QwenPaw 2.2 venv) ----
ARG QWENPAW_PIP_SPEC=qwenpaw==2.2.1
RUN python3 -m venv /opt/venv/qwenpaw \
    && /opt/venv/qwenpaw/bin/pip install --no-cache-dir \
        -i "${PIP_INDEX_URL}" \
        --trusted-host "$(echo ${PIP_INDEX_URL} | sed 's|https\?://||;s|/.*||')" \
        "${QWENPAW_PIP_SPEC}"

ENV PATH="/opt/venv/qwenpaw/bin:${PATH}"

# ---- AgentTeams Manager runtime package (config bridge + Manager tools) ----
# Own package for the Manager (agentteams_manager), installed into the
# qwenpaw venv.  Its dependencies (PyYAML / markdown-it-py / linkify-it-py)
# are declared explicitly so they do not rely on transitive resolution.
RUN /opt/venv/qwenpaw/bin/pip install --no-cache-dir \
        -i "${PIP_INDEX_URL}" \
        --trusted-host "$(echo ${PIP_INDEX_URL} | sed 's|https\?://||;s|/.*||')" \
        "PyYAML>=6.0" \
        "markdown-it-py>=3.0" \
        "linkify-it-py>=2.0"
COPY manager/src/agentteams_manager/ /tmp/agentteams-manager/
RUN /opt/venv/qwenpaw/bin/pip install --no-cache-dir \
        -i "${PIP_INDEX_URL}" \
        --trusted-host "$(echo ${PIP_INDEX_URL} | sed 's|https\?://||;s|/.*||')" \
        --no-deps \
        /tmp/agentteams-manager/ \
    && rm -rf /tmp/agentteams-manager/

# ---- CMS Observability Plugin (in qwenpaw venv) ----
# Aligned with qwenpaw Worker Dockerfile: installed into the runtime venv
# (qwenpaw) so that loongsuite-site-bootstrap is active when the Manager
# process starts.  instrumentation-qwenpaw (not -copaw) +
# loongsuite-otel-util-genai for GenAI semantic conventions.
RUN /opt/venv/qwenpaw/bin/pip install --no-cache-dir \
        -i "${PIP_INDEX_URL}" \
        --trusted-host "$(echo ${PIP_INDEX_URL} | sed 's|https\?://||;s|/.*||')" \
        "wrapt<2.0" \
        loongsuite-site-bootstrap \
        loongsuite-distro \
        loongsuite-otel-util-genai \
        opentelemetry-exporter-otlp \
        loongsuite-instrumentation-qwenpaw \
        loongsuite-instrumentation-agentscope

# qwenpaw CLI on PATH
RUN ln -sf /opt/venv/qwenpaw/bin/qwenpaw /usr/local/bin/qwenpaw

# AgentTeams plugins: Matrix channel + Manager tools
# Stored in image-local path (/opt/agentteams/plugins/). At runtime,
# start-qwenpaw-manager.sh copies them into the working dir's plugins/
# directory because /root/manager-workspace is a host-mounted volume.
COPY plugins/agentteams-matrix-channel/ /opt/agentteams/plugins/agentteams-matrix-channel/
COPY plugins/agentteams-manager-tools/ /opt/agentteams/plugins/agentteams-manager-tools/

# ---- Copy Manager agent definitions ----
COPY manager/agent/ /opt/agentteams/agent/
COPY manager/configs/ /opt/agentteams/configs/

# ---- Copy scripts: shared libs first, then manager scripts ----
COPY shared/lib/ /opt/agentteams/scripts/lib/
COPY manager/scripts/ /opt/agentteams/scripts/

ARG BUILTIN_VERSION=latest
RUN echo "${BUILTIN_VERSION}" > /opt/agentteams/agent/.builtin-version

# Make all scripts executable
RUN find /opt/agentteams/scripts -name '*.sh' -exec chmod +x {} + && \
    find /opt/agentteams/agent/skills/*/scripts -name '*.sh' -exec chmod +x {} + 2>/dev/null || true && \
    find /opt/agentteams/agent/worker-skills/*/scripts -name '*.sh' -exec chmod +x {} + 2>/dev/null || true && \
    find /opt/agentteams/agent/worker-agent/skills/*/scripts -name '*.sh' -exec chmod +x {} + 2>/dev/null || true

# Workspace directory
ENV HOME=/root/manager-workspace
RUN mkdir -p /root/manager-workspace /root/agentteams-fs /root/.openclaw

# QwenPaw 2.2.1 reload must not overwrite a concurrent policy update.
COPY qwenpaw/scripts/patch-qwenpaw-driver-policy-reload.py /tmp/patch-qwenpaw-driver-policy-reload.py
COPY qwenpaw/tests/check_driver_policy_reload.py /tmp/check_driver_policy_reload.py
RUN /opt/venv/qwenpaw/bin/python /tmp/patch-qwenpaw-driver-policy-reload.py && \
    /opt/venv/qwenpaw/bin/python /tmp/check_driver_policy_reload.py && \
    rm /tmp/patch-qwenpaw-driver-policy-reload.py /tmp/check_driver_policy_reload.py

WORKDIR /root/manager-workspace

# start-manager-agent.sh branches on AGENTTEAMS_RUNTIME and AGENTTEAMS_MANAGER_RUNTIME
ENTRYPOINT ["/opt/agentteams/scripts/init/start-manager-agent.sh"]
