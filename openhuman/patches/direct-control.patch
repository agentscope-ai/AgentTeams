diff --git a/tests/agentteams_direct_control.rs b/tests/agentteams_direct_control.rs
new file mode 100644
index 0000000..f1d3ee2
--- /dev/null
+++ b/tests/agentteams_direct_control.rs
@@ -0,0 +1,115 @@
+#![cfg(unix)]
+use openhuman_core::openhuman::{
+    agent::host_runtime::NativeRuntime,
+    security::{AutonomyLevel, SecurityPolicy},
+    tools::{ShellTool, Tool},
+};
+use serde_json::json;
+use std::sync::Arc;
+use std::time::Duration;
+use std::os::unix::fs::PermissionsExt;
+
+#[path = "../src/openhuman/channels/matrix_direct.rs"]
+mod matrix_direct;
+
+#[tokio::test]
+async fn matrix_run_acknowledges_only_after_cleanup_and_retains_supplements() {
+    use matrix_sdk::{Client, SessionMeta, SessionTokens, config::SyncSettings, authentication::matrix::MatrixSession};
+    use wiremock::{Mock, MockServer, ResponseTemplate, matchers::{method, path, path_regex}};
+    let server = MockServer::start().await;
+    Mock::given(method("GET")).and(path("/_matrix/client/versions"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({"versions": ["v1.13"]}))).mount(&server).await;
+    Mock::given(method("GET")).and(path("/_matrix/client/v3/sync"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+            "next_batch": "cursor", "rooms": {"join": {"!dm:test": {
+                "timeline": {"events": [], "limited": false},
+                "state": {"events": [
+                    {"type": "m.room.create", "state_key": "", "sender": "@agent:test", "event_id": "$create", "origin_server_ts": 1, "content": {"creator": "@agent:test", "room_version": "10"}},
+                    {"type": "m.room.member", "state_key": "@agent:test", "sender": "@agent:test", "event_id": "$member", "origin_server_ts": 2, "content": {"membership": "join"}}
+                ]}
+            }}}
+        }))).mount(&server).await;
+    Mock::given(method("PUT")).and(path_regex("/_matrix/client/v3/rooms/.*/send/m.room.message/.*"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({"event_id": "$status"}))).mount(&server).await;
+    Mock::given(method("GET")).and(path_regex("/_matrix/client/v3/rooms/.*/state/m.room.encryption/"))
+        .respond_with(ResponseTemplate::new(404).set_body_json(json!({"errcode": "M_NOT_FOUND", "error": "Not encrypted"}))).mount(&server).await;
+    let client = Client::builder().homeserver_url(server.uri()).build().await.unwrap();
+    client.restore_session(MatrixSession {
+        meta: SessionMeta { user_id: "@agent:test".try_into().unwrap(), device_id: "TEST".into() },
+        tokens: SessionTokens { access_token: "local-test-only".into(), refresh_token: None },
+    }).await.unwrap();
+    client.sync_once(SyncSettings::default()).await.unwrap();
+    let room_id: matrix_sdk::ruma::OwnedRoomId = "!dm:test".try_into().unwrap();
+    let room = client.get_room(&room_id).unwrap();
+    matrix_direct::register(room.clone(), "$original".into(), "@human:test".into(), vec!["原任务".into()]);
+    let original = matrix_direct::get("$original").unwrap();
+    original.start().await;
+    assert_eq!(matrix_direct::active("!dm:test").unwrap().sender, "@human:test");
+    original.cancel.cancel();
+    assert!(!original.done.is_cancelled(), "request must not acknowledge cleanup");
+    original.finish().await;
+    assert!(original.done.is_cancelled());
+    assert!(matrix_direct::active("!dm:test").is_none());
+    let mut inputs = original.inputs.clone();
+    inputs.push("补充杭州".into());
+    matrix_direct::register(room, "$supplement".into(), "@human:test".into(), inputs);
+    let replacement = matrix_direct::get("$supplement").unwrap();
+    replacement.start().await;
+    assert_eq!(replacement.inputs, ["原任务", "补充杭州"]);
+    replacement.finish().await;
+    let statuses: Vec<_> = server.received_requests().await.unwrap().into_iter()
+        .filter_map(|request| serde_json::from_slice::<serde_json::Value>(&request.body).ok())
+        .filter_map(|body| body.pointer("/com.agentteams.execution/status").and_then(|v| v.as_str()).map(str::to_owned)).collect();
+    assert_eq!(statuses, ["running", "stopped", "running", "completed"]);
+}
+
+#[tokio::test]
+async fn shell_cancellation_stops_shell_and_children() {
+    let directory = tempfile::tempdir().unwrap();
+    let pidfile = directory.path().join("pid");
+    let marker = directory.path().join("must-not-run");
+    let security = Arc::new(SecurityPolicy {
+        autonomy: AutonomyLevel::Full,
+        workspace_dir: directory.path().to_path_buf(),
+        allowed_commands: vec!["at-dm-long-tool".into()],
+        ..SecurityPolicy::default()
+    });
+    let tool = ShellTool::new(security, Arc::new(NativeRuntime::new()));
+    let script = directory.path().join("at-dm-long-tool");
+    std::fs::write(&script, format!("#!/usr/bin/env python3\nimport os,pathlib,subprocess\nchild=subprocess.Popen(['sleep','30'])\npathlib.Path({:?}).write_text(str(os.getpid())+','+str(child.pid))\nchild.wait()\npathlib.Path({:?}).touch()\n", pidfile.to_str().unwrap(), marker.to_str().unwrap())).unwrap();
+    std::fs::set_permissions(&script, std::fs::Permissions::from_mode(0o700)).unwrap();
+    let command = "./at-dm-long-tool";
+    let task = tokio::spawn(async move { tool.execute(json!({"command": command, "approved": true})).await });
+    for _ in 0..200 {
+        if pidfile.exists() { break; }
+        tokio::time::sleep(Duration::from_millis(25)).await;
+    }
+    if !pidfile.exists() && task.is_finished() {
+        panic!("native shell rejected fixture: {:?}", task.await.unwrap());
+    }
+    assert!(pidfile.exists(), "native shell never started");
+    let pids: Vec<i32> = std::fs::read_to_string(&pidfile).unwrap().trim().split(',')
+        .map(|pid| pid.parse().unwrap()).collect();
+    task.abort();
+    let _ = task.await;
+    for pid in pids {
+        let stopped = || {
+            if nix::sys::signal::kill(nix::unistd::Pid::from_raw(pid), None) == Err(nix::errno::Errno::ESRCH) {
+                return true;
+            }
+            // Linux can retain an exited orphan as a zombie until init reaps
+            // it. kill(pid, 0) alone does not distinguish it from live work.
+            #[cfg(target_os = "linux")]
+            if let Ok(stat) = std::fs::read_to_string(format!("/proc/{pid}/stat")) {
+                return stat.rsplit_once(')').is_some_and(|(_, fields)| fields.trim_start().starts_with('Z'));
+            }
+            false
+        };
+        for _ in 0..100 {
+            if stopped() { break; }
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+        assert!(stopped(), "tool process {pid} remained alive after cancellation");
+    }
+    assert!(!marker.exists());
+}
