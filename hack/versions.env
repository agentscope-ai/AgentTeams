# Pinned runtime versions for the AgentTeams container build.
# Source this file or grep the keys; the Dockerfile ARG defaults
# mirror these values (Docker cannot source env files, so the two
# must be kept in sync manually — tests/build/test_version_pins.py
# enforces that).
#
# P3c (this PR) owns OpenClaw only. QwenPaw (P3a) and Hermes (P3b)
# add their own keys in separate PRs so a failing OpenClaw build does
# not block the other runtime bumps.
OPENCLAW_TAG=v2026.10.9

# Immutable tag the openclaw-base image is published/consumed under.
# Derived: <OPENCLAW_TAG without the leading v>-node<NODE_MIN_VERSION>
# (NODE_MIN_VERSION is an ARG in openclaw-base/Dockerfile).
# tests/build/test_version_pins.py asserts this formula and that no other
# file hard-codes a different tag, so a pin bump cannot leave stale pointers.
OPENCLAW_BASE_TAG=2026.10.9-node24.22.1
