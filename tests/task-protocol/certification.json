{
  "schemaVersion": 2,
  "planningPolicy": "leader_decides",
  "status": "not_started",
  "firstHarness": "qwenpaw",
  "secondHarness": "openclaw",
  "conditions": {
    "model": "qwen3.6-plus",
    "cpuPerMember": 2,
    "memoryGiBPerMember": 4,
    "leaderCount": 1,
    "workerCount": 2,
    "entry": "original-human-manager-room",
    "contentCapture": false
  },
  "cases": [
    {
      "id": "simple-csv",
      "spec": "cases/requirements-only/simple-csv.md",
      "repetitions": 3,
      "timeoutSeconds": 300
    },
    {
      "id": "complex-settlement",
      "spec": "cases/requirements-only/complex-settlement.md",
      "repetitions": 3,
      "timeoutSeconds": 900
    }
  ],
  "stages": [
    {
      "id": "baseline-qwenpaw",
      "leader": "qwenpaw",
      "worker": "qwenpaw",
      "requires": []
    },
    {
      "id": "candidate-qwenpaw",
      "leader": "qwenpaw",
      "worker": "qwenpaw",
      "requires": [
        "baseline-qwenpaw"
      ]
    },
    {
      "id": "candidate-openclaw",
      "leader": "openclaw",
      "worker": "openclaw",
      "requires": [
        "candidate-qwenpaw"
      ]
    },
    {
      "id": "cross-qwenpaw-openclaw",
      "leader": "qwenpaw",
      "worker": "openclaw",
      "requires": [
        "candidate-openclaw"
      ]
    },
    {
      "id": "cross-openclaw-qwenpaw",
      "leader": "openclaw",
      "worker": "qwenpaw",
      "requires": [
        "candidate-openclaw"
      ]
    }
  ],
  "successRequires": [
    "no_manual_intervention",
    "business_oracle_passed",
    "leader_accepted",
    "artifacts_verified",
    "original_room_report_verified",
    "trace_coverage_verified",
    "sender_tool_notification_receipt_verified"
  ],
  "measurementNotes": [
    "Fresh request/Task IDs for repeated identical specs; retain terminal tasks.",
    "Duplicate delivery tests reuse the same operation identity and are separate from repeated task execution.",
    "Timeouts, failed attempts and manual recoveries remain in the denominator.",
    "Timeout budgets are preliminary and must be frozen before both baseline and candidate runs; they are not latency targets.",
    "Protocol conformance and recovery tests must also pass before the next Harness is modified."
  ],
  "businessOracle": {
    "runner": "run_oracle.py",
    "checks": "business_oracle.py",
    "freezeStatus": "not_frozen",
    "isolation": "networkless disposable Docker container",
    "verifierSelftestOnly": true
  }
}
