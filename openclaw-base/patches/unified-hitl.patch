@@ -0,0 +1,12 @@
+/** Translate the shared wire decision; native command admission still owns authorization. */
+export function dashboardApprovalCommand(answer: unknown, own: string): string | undefined {
+  if (!answer || typeof answer !== "object" || Array.isArray(answer)) return undefined;
+  const value = answer as Record<string, unknown>;
+  if (value.kind !== "tool_approval") return undefined;
+  const id = value.confirmation_id;
+  if (value.agent_id !== own || typeof id !== "string" || !/^[\w.:-]+$/.test(id)
+    || value.context_id !== id) return "";
+  if (value.answer === "approved") return `/approve ${id} allow-once`;
+  if (value.answer === "rejected") return `/approve ${id} deny`;
+  return "";
+}
