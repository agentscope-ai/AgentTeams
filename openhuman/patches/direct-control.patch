index 0000000..f97ed87
--- /dev/null
+++ b/src/openhuman/channels/matrix_direct.rs
@@ -0,0 +1,75 @@
+//! Run-scoped controls for verified human/agent Matrix direct conversations.
+use matrix_sdk::Room;
+use once_cell::sync::Lazy;
+use serde_json::json;
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+use tokio_util::sync::CancellationToken;
+
+pub(crate) struct DirectRun {
+    pub id: String,
+    pub sender: String,
+    pub inputs: Vec<String>,
+    pub room: Room,
+    pub cancel: CancellationToken,
+    pub done: CancellationToken,
+}
+
+static RUNS: Lazy<Mutex<HashMap<String, Arc<DirectRun>>>> =
+    Lazy::new(|| Mutex::new(HashMap::new()));
+static ACTIVE: Lazy<Mutex<HashMap<String, Arc<DirectRun>>>> =
+    Lazy::new(|| Mutex::new(HashMap::new()));
+
+pub(crate) fn register(room: Room, id: String, sender: String, inputs: Vec<String>) {
+    let run = Arc::new(DirectRun { id: id.clone(), sender, inputs, room,
+        cancel: CancellationToken::new(), done: CancellationToken::new() });
+    RUNS.lock().unwrap().insert(id, run);
+}
+
+pub(crate) fn get(id: &str) -> Option<Arc<DirectRun>> {
+    RUNS.lock().unwrap().get(id).cloned()
+}
+
+pub(crate) fn active(room: &str) -> Option<Arc<DirectRun>> {
+    ACTIVE.lock().unwrap().get(room).cloned()
+}
+
+impl DirectRun {
+    pub async fn status(&self, status: &str) {
+        let body = match status {
+            "running" => "正在执行", "stopping" => "正在停止", "stopped" => "已停止",
+            "completed" => "本轮已结束", _ => "执行失败",
+        };
+        let content = json!({"msgtype": "m.notice", "body": body,
+            "com.agentteams.execution": {"run_id": self.id, "status": status,
+                "capabilities": ["stop", "steer"]}});
+        if let Err(error) = self.room.send_raw("m.room.message", content).await {
+            tracing::warn!("Matrix execution status delivery failed: {error}");
+        }
+    }
+
+    pub async fn start(self: &Arc<Self>) {
+        // Preserve the native room history order for ordinary follow-up input.
+        loop {
+            let previous = {
+                let mut active = ACTIVE.lock().unwrap();
+                if let Some(previous) = active.get(self.room.room_id().as_str()) {
+                    Some(previous.clone())
+                } else {
+                    active.insert(self.room.room_id().to_string(), self.clone());
+                    None
+                }
+            };
+            let Some(previous) = previous else { break };
+            previous.done.cancelled().await;
+        }
+        self.status("running").await;
+    }
+
+    pub async fn finish(&self) {
+        self.status(if self.cancel.is_cancelled() { "stopped" } else { "completed" }).await;
+        RUNS.lock().unwrap().remove(&self.id);
+        ACTIVE.lock().unwrap().remove(self.room.room_id().as_str());
+        self.done.cancel();
+    }
+}
