diff --git a/src/openhuman/approval/matrix.rs b/src/openhuman/approval/matrix.rs
new file mode 100644
index 0000000..0ede6ab
--- /dev/null
+++ b/src/openhuman/approval/matrix.rs
@@ -0,0 +1,176 @@
+//! Request-bound Matrix approvals for channel turns.
+use super::{ApprovalManager, ApprovalRequest, ApprovalResponse};
+use crate::openhuman::channels::traits::Channel;
+use std::{
+    collections::HashMap,
+    sync::{Arc, LazyLock, Mutex},
+};
+use tokio::sync::oneshot;
+
+pub(crate) struct Context {
+    pub manager: Arc<ApprovalManager>,
+    pub channel: Arc<dyn Channel>,
+    pub room: String,
+    pub sender: String,
+}
+
+tokio::task_local! { pub(crate) static CONTEXT: Arc<Context>; }
+
+struct Pending {
+    room: String,
+    sender: String,
+    admin: Option<String>,
+    context: String,
+    answer: oneshot::Sender<ApprovalResponse>,
+}
+static PENDING: LazyLock<Mutex<HashMap<String, Pending>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+
+pub(crate) struct Waiter {
+    pub id: String,
+    pub context: String,
+    pub receiver: oneshot::Receiver<ApprovalResponse>,
+    pub on_cancel: Option<Box<dyn FnOnce() + Send>>,
+}
+
+impl Waiter {
+    pub fn new(room: &str, sender: &str, admin: Option<String>) -> Self {
+        let id = uuid::Uuid::new_v4().to_string();
+        let context = uuid::Uuid::new_v4().to_string();
+        let (answer, receiver) = oneshot::channel();
+        PENDING.lock().unwrap().insert(
+            id.clone(),
+            Pending {
+                room: room.into(),
+                sender: sender.into(),
+                admin,
+                context: context.clone(),
+                answer,
+            },
+        );
+        Self {
+            id,
+            context,
+            receiver,
+            on_cancel: None,
+        }
+    }
+}
+
+impl Drop for Waiter {
+    fn drop(&mut self) {
+        PENDING.lock().unwrap().remove(&self.id);
+        if let Some(cancel) = self.on_cancel.take() {
+            cancel();
+        }
+    }
+}
+
+/// Consume transport commands before the model sees them; only the original
+/// requester in the original room can resolve this exact waiter once.
+pub(crate) fn answer(room: &str, sender: &str, body: &str) -> bool {
+    let fields: Vec<_> = body
+        .split_whitespace()
+        .skip_while(|word| word.starts_with('@'))
+        .collect();
+    if fields.first() != Some(&"/agentteams-approval") {
+        return false;
+    }
+    if fields.len() != 4 || !matches!(fields[1], "approve" | "deny") {
+        return true;
+    }
+    let mut pending = PENDING.lock().unwrap();
+    let Some(entry) = pending.get(fields[2]) else {
+        return true;
+    };
+    if entry.room != room
+        || (entry.sender != sender && entry.admin.as_deref() != Some(sender))
+        || entry.context != fields[3]
+    {
+        return true;
+    }
+    let entry = pending.remove(fields[2]).unwrap();
+    let _ = entry.answer.send(if fields[1] == "approve" {
+        ApprovalResponse::Yes
+    } else {
+        ApprovalResponse::No
+    });
+    true
+}
+
+pub(crate) fn payload(
+    waiter: &Waiter,
+    request: &ApprovalRequest,
+    status: &str,
+) -> serde_json::Value {
+    serde_json::json!({
+        "version": 1, "runtime": "openhuman", "request_id": waiter.id,
+        "context_id": waiter.context, "status": status,
+        "tool_name": request.tool_name, "parameters": request.arguments.to_string(),
+        "expires_at": chrono::Utc::now().timestamp_millis() + 300_000,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn dropping_a_waiter_withdraws_its_control_and_reports_cancellation() {
+        use std::sync::atomic::{AtomicBool, Ordering};
+        let cancelled = Arc::new(AtomicBool::new(false));
+        let signal = cancelled.clone();
+        let mut waiter = Waiter::new("!cancel", "@owner", None);
+        waiter.on_cancel = Some(Box::new(move || {
+            signal.store(true, Ordering::SeqCst);
+        }));
+        let command = format!(
+            "/agentteams-approval approve {} {}",
+            waiter.id, waiter.context
+        );
+        drop(waiter);
+        assert!(cancelled.load(Ordering::SeqCst));
+        assert!(answer("!cancel", "@owner", &command));
+        assert!(!PENDING
+            .lock()
+            .unwrap()
+            .values()
+            .any(|entry| entry.room == "!cancel"));
+    }
+
+    #[tokio::test]
+    async fn decisions_are_bound_to_room_sender_and_context() {
+        for (action, expected) in [
+            ("approve", ApprovalResponse::Yes),
+            ("deny", ApprovalResponse::No),
+        ] {
+            let mut waiter = Waiter::new("!room", "@owner", Some("@admin".into()));
+            let body = format!(
+                "/agentteams-approval {action} {} {}",
+                waiter.id, waiter.context
+            );
+            assert!(answer("!other", "@owner", &body));
+            assert!(answer("!room", "@other", &body));
+            assert!(answer(
+                "!room",
+                "@owner",
+                &body.replace(&waiter.context, "stale")
+            ));
+            assert!(matches!(
+                waiter.receiver.try_recv(),
+                Err(oneshot::error::TryRecvError::Empty)
+            ));
+            assert!(answer(
+                "!room",
+                if action == "approve" {
+                    "@admin"
+                } else {
+                    "@owner"
+                },
+                &body
+            ));
+            assert_eq!((&mut waiter.receiver).await.unwrap(), expected);
+            assert!(answer("!room", "@owner", &body));
+        }
+    }
+}
